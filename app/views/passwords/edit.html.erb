<% content_for :title, t(".title") %>

<div class="auth__heading">
  <h1 class="auth__title"><%= t(".title") %></h1>
  <p class="auth__text"><%= t(".explanation") %></p>
</div>

<%= form_with url: password_path(params[:token]), method: :put, class: "auth__form" do |form| %>
  <% blank = @user.errors.added?(:password, :blank) %>
  <div class="field field--prominent">
    <div class="field__header">
      <%= form.label :password, t(".password_label"), class: "field__label" %>
    </div>
    <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", maxlength: 72, class: "field__input",
          aria: { invalid: blank, describedby: ("password-error" if blank) } %>
    <%= render "shared/inline_error", id: "password-error", message: t("passwords.update.blank") if blank %>
  </div>

  <% mismatch = @user.errors.include?(:password_confirmation) %>
  <div class="field field--prominent">
    <div class="field__header">
      <%= form.label :password_confirmation, t(".password_confirmation_label"), class: "field__label" %>
    </div>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "field__input",
          aria: { invalid: mismatch, describedby: ("password-confirmation-error" if mismatch) } %>
    <%= render "shared/inline_error", id: "password-confirmation-error", message: t("passwords.update.mismatch") if mismatch %>
  </div>

  <%= form.button t(".submit"), class: "button button--primary button--large button--block auth__submit" %>
<% end %>
