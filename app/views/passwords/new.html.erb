<% content_for :title, t(".title") %>

<div class="auth__heading">
  <h1 class="auth__title"><%= t(".title") %></h1>
  <p class="auth__text"><%= t(".explanation") %></p>
</div>

<%# The response renders "Check your inbox" in place, so the address never travels in a URL %>
<%= form_with url: passwords_path, class: "auth__form", data: { turbo: false } do |form| %>
  <div class="field field--prominent">
    <div class="field__header">
      <%= form.label :email_address, t(".email_label"), class: "field__label" %>
    </div>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "field__input" %>
  </div>

  <%= form.button t(".submit"), class: "button button--primary button--large button--block auth__submit" %>
<% end %>

<p class="auth__note"><%= link_to t(".back"), new_session_path %></p>
