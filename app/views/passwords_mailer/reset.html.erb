<p style="margin: 0 0 16px;"><%= t(".action") %> <%= t(".constraint") %></p>

<p style="margin: 24px 0;">
  <%= link_to t(".cta"), edit_password_url(@user.password_reset_token),
        style: "display: inline-block; padding: 12px 24px; border-radius: 6px; background-color: #2B4870; color: #FBFAF6; font-family: -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 16px; font-weight: 600; text-decoration: none;" %>
</p>

<p style="margin: 0 0 4px; font-family: -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 14px; color: #625B50;"><%= t(".link_note") %></p>
<p style="margin: 0 0 24px; font-family: Menlo, Consolas, monospace; font-size: 14px; word-break: break-all;"><%= link_to edit_password_url(@user.password_reset_token), edit_password_url(@user.password_reset_token), style: "color: #2B4870;" %></p>

<p style="margin: 0; font-family: -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 14px; color: #625B50;"><%= t(".ignore_note") %></p>
