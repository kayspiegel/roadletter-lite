<% content_for :title, t(".title") %>
<h1 class="visually-hidden"><%= t(".title") %></h1>

<%= form_with url: session_path, class: "auth__form" do |form| %>
  <div class="field field--prominent">
    <div class="field__header">
      <%= form.label :email_address, t(".email_label"), class: "field__label" %>
    </div>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "field__input" %>
  </div>

  <div class="field field--prominent">
    <div class="field__header">
      <%= form.label :password, t(".password_label"), class: "field__label" %>
      <%= link_to t(".forgot_password"), new_password_path, class: "field__aside" %>
    </div>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "field__input" %>
  </div>

  <%= form.button t(".submit"), class: "button button--primary button--large button--block auth__submit" %>
<% end %>

<p class="auth__note"><%= t(".single_account_note") %></p>
